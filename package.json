{
  "name": "opencode-vitals",
  "version": "0.1.5",
  "description": "OpenCode V2 plugin that shows session turns, steps, and average streaming tok/s in a small always-on-top bar",
  "author": {
    "name": "Moutaz Darwesh",
    "url": "https://github.com/moutazideal"
  },
  "license": "MIT",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js"
  },
  "bin": {
    "opencode-vitals": "cli.mjs",
    "opencode-vitals-selftest": "selftest.mjs",
    "opencode-vitals-install": "install.mjs"
  },
  "files": [
    "index.js",
    "bar.py",
    "start-bar.sh",
    "selftest.py",
    "cli.mjs",
    "install.mjs",
    "selftest.mjs",
    "docs/bar.png",
    "docs/bar-mini.png",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node tests/vitals.test.mjs && python3 tests/bar.test.py",
    "selftest": "python3 selftest.py",
    "prepublishOnly": "npm test"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "vitals",
    "latency",
    "tokens-per-second",
    "benchmark",
    "observability",
    "tkinter",
    "always-on-top",
    "session-metrics"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moutazideal/opencode-vitals.git"
  },
  "bugs": {
    "url": "https://github.com/moutazideal/opencode-vitals/issues"
  },
  "homepage": "https://github.com/moutazideal/opencode-vitals#readme",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  }
}
